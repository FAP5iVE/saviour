# ---------------------------------------------------------------
# Saviour Digital Solutions site: files Git must NOT track
# (assets/vendor/ is deliberately tracked: it is the self-hosted
#  GSAP + Lenis bundle the live site needs.)
# ---------------------------------------------------------------

# Dependencies
node_modules/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Secrets and local environment (never commit these)
.env
.env.*
!.env.example
*.pem
*.key

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editors (shared VS Code settings are kept on purpose)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Build and test output
dist/
.cache/
coverage/
.lighthouseci/
lighthouse-*.html
lighthouse-*.json

# Hosting CLIs (local state)
.wrangler/
.netlify/
.vercel/

# Raw source media: keep originals out of Git, commit only the optimised files
/raw/
*.psd
*.ai
*.fig
*.mov
*.zip
