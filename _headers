# Headers for Cloudflare Pages and Netlify (same file format).
# Lines starting with # are comments.
#
# The sha256 in script-src is the hash of the one inline script in index.html
# (the one that adds the "js" and "sv-loading" classes). If you edit that script, run: npm run csp:check
#
# When analytics is added (Cloudflare Web Analytics), also allow:
#   script-src  https://static.cloudflareinsights.com
#   connect-src https://cloudflareinsights.com
#
# style-src-attr 'unsafe-inline' lets GSAP and SplitText set style attributes.
# It does not allow inline <style> blocks or inline scripts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-9R93cLETfn7nETnTja0KmtasP8wpAbCXKFn04zjFp00=' https://static.cloudflareinsights.com; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://api.web3forms.com https://cloudflareinsights.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# Fonts rarely change: cache for a year. Rename a font file if you replace it.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video: 30 days.
/assets/img/*
  Cache-Control: public, max-age=2592000
/assets/video/*
  Cache-Control: public, max-age=2592000

# CSS, JS and the vendor bundle keep the same file names, so always revalidate (fast 304s).
# Switch these to long-lived caching only after file names are fingerprinted.
/css/*
  Cache-Control: public, max-age=0, must-revalidate
/js/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/vendor/*
  Cache-Control: public, max-age=0, must-revalidate
