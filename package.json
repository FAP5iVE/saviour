{
  "name": "saviour-digital-solutions-site",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Marketing website for Saviour Digital Solutions, Blantyre, Malawi. Plain HTML, CSS and JavaScript (ES modules).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "serve . --listen 3000",
    "vendor": "node scripts/vendor.mjs",
    "icons": "node scripts/icons.mjs",
    "pin": "node scripts/pin-versions.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint js scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "qa": "bash scripts/qa-check.sh .",
    "csp:check": "node scripts/csp-check.mjs",
    "check": "npm run lint && npm run csp:check && npm run qa",
    "lighthouse": "npx --yes lighthouse http://localhost:3000 --form-factor=mobile --only-categories=performance,accessibility,best-practices,seo --view",
    "deps:outdated": "npm outdated"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^4.0.0",
    "globals": "^17.14.0",
    "lucide": "^1.67.0",
    "prettier": "^3.9.10",
    "serve": "^10.0.2"
  }
}
